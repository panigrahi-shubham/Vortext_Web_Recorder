{
  "manifest_version": 3,
  "name": "Vortex Locator Scout",
  "version": "2.0.0",
  "description": "Pick any element and get ranked, verified locators for Playwright and Selenium. Rule-based, no AI, nothing leaves the browser.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "contextMenus",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Vortex Locator Scout"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "toggle-picker": {
      "suggested_key": {
        "default": "Alt+Shift+L",
        "mac": "Alt+Shift+L"
      },
      "description": "Toggle the element picker"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "version_name": "2.0.0-beta.1"
}
