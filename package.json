{
  "name": "vortex-web-recorder",
  "version": "2.0.0-beta.1",
  "description": "Smart Playwright recorder that writes Page Objects, resilient locators and suggested assertions",
  "scripts": {
    "record": "tsx src/framework/cli.ts record",
    "check": "tsx src/cli.ts check",
    "demo": "tsx src/cli.ts demo",
    "fixture-site": "tsx src/cli.ts serve-fixtures",
    "test": "node --import tsx --test --test-concurrency=1 \"test/unit/*.test.ts\" \"test/integration/*.test.ts\"",
    "test:unit": "node --import tsx --test \"test/unit/*.test.ts\"",
    "test:integration": "node --import tsx --test --test-concurrency=1 \"test/integration/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "generate": "tsx src/cli.ts generate",
    "audit": "tsx src/cli.ts audit",
    "qa": "tsx src/framework/cli.ts",
    "qa:modules": "tsx src/framework/cli.ts modules",
    "qa:record": "tsx src/framework/cli.ts record",
    "qa:run": "tsx src/framework/cli.ts run",
    "qa:check": "tsc --noEmit -p tsconfig.qa.json",
    "qa:report": "playwright show-report reports/latest/html",
    "record:legacy": "tsx src/cli.ts record",
    "qa:doctor": "tsx src/framework/cli.ts doctor",
    "scout": "tsx src/framework/cli.ts scout",
    "build": "npm run build:extension && npm run build:npm",
    "build:extension": "npm --prefix extension run build",
    "build:npm": "node scripts/build.mjs",
    "test:extension": "npm --prefix extension test -- --maxWorkers=2 --minWorkers=1",
    "typecheck:extension": "npm --prefix extension run typecheck",
    "prepack": "npm run build",
    "release": "npm run build && node scripts/release.mjs",
    "test:package": "node scripts/smoke-package.mjs"
  },
  "keywords": [
    "playwright",
    "recorder",
    "codegen",
    "page-object",
    "test-automation"
  ],
  "author": "Suresh IT Academy",
  "license": "MIT",
  "devDependencies": {
    "fflate": "^0.8.3",
    "tsx": "^4.23.15"
  },
  "private": false,
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "vortex-qa": "dist/framework/cli.js",
    "vortex-recorder": "dist/cli.js"
  },
  "files": [
    "dist/",
    "fixtures/site/",
    "playwright.config.ts",
    "tsconfig.qa.json",
    "README.md",
    "AI-GUIDE.md",
    "AUTHORING-GUIDE.md",
    "V2-VALIDATION.md"
  ],
  "dependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^24.19.2",
    "playwright": "1.56.1",
    "typescript": "~5.9"
  }
}
